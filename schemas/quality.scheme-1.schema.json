            "rejected": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "of": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            }
          },
          "additionalProperties": false,
          "description": "Normal to tightened when this many of the last lots were rejected."
        },
        "to_normal": {
          "type": "integer",
          "minimum": 1,
          "description": "Tightened to normal after this many consecutive accepted lots.",
          "default": 5
        },
        "to_reduced": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Normal to reduced after this many consecutive accepted lots (null: never).",
          "default": null
        },
        "discontinue": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Stop accepting lots when this many are rejected during one period of tightened inspection (null: never); `resume` restarts on tightened.",
          "default": 5
        }
      },
      "additionalProperties": false
