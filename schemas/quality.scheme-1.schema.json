          "type": "string",
          "enum": [
            "normal",
            "tightened",
            "reduced"
          ],
          "description": "The plan a resubmitted lot is inspected with.",
          "default": "tightened"
        }
      },
      "additionalProperties": false
    },
    "supplier_watch": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "CUSUM threshold over all items of first presentations, from aql to lq of the normal plan: a lasting deterioration of the supplier, across lots."
